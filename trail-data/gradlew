#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
gradle_version="$(sed -n 's/^distributionUrl=.*gradle-\([^/]*\)-bin\.zip$/\1/p' "$script_dir/gradle/wrapper/gradle-wrapper.properties")"
if [[ -z "$gradle_version" ]]; then
  echo "could not read the pinned Gradle version" >&2
  exit 1
fi

cache_root="${TRAIL_GRADLE_CACHE:-${GRADLE_USER_HOME:-/tmp/fogofwalk-gradle}}/wrapper/dists"
distribution="$cache_root/gradle-${gradle_version}"
gradle_bin="$distribution/bin/gradle"
if [[ ! -x "$gradle_bin" ]]; then
  archive="$cache_root/gradle-${gradle_version}-bin.zip"
  mkdir -p "$cache_root"
  if [[ ! -f "$archive" ]]; then
    curl --fail --location --retry 3 \
      "https://services.gradle.org/distributions/gradle-${gradle_version}-bin.zip" \
      --output "$archive"
  fi
  unpack_dir="$(mktemp -d "${TMPDIR:-/tmp}/fogofwalk-gradle.XXXXXX")"
  trap 'rm -rf "$unpack_dir"' EXIT
  unzip -q "$archive" -d "$unpack_dir"
  mv "$unpack_dir/gradle-${gradle_version}" "$distribution"
fi

exec "$gradle_bin" "$@"
