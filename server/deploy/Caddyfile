# Installed at /etc/caddy/Caddyfile by provision.sh. TLS is automatic:
# Caddy obtains and renews a Let's Encrypt certificate on its own, which is why
# port 80 has to stay open (ACME HTTP challenge) even though nothing is served
# there.
#
# The API owns its own CORS headers. The static trail archive below is public,
# immutable map data and therefore has an explicit wildcard CORS policy.

api.fog-of-walk.mykhailo.net {
	encode zstd gzip

	# The server binds 127.0.0.1 (HOST in server.env), so this proxy is the
	# only way in.
	handle_path /map-data/trails/v1/* {
		root * /srv/fogofwalk/map-data/trails/v1
		header {
			Access-Control-Allow-Origin "*"
			Access-Control-Allow-Methods "GET, HEAD, OPTIONS"
			Access-Control-Allow-Headers "Range, If-Match"
			Access-Control-Expose-Headers "Accept-Ranges, Content-Length, Content-Range, ETag"
			Accept-Ranges "bytes"
			Cache-Control "public, max-age=31536000, immutable"
			Content-Type "application/octet-stream"
		}
		@trail_options method OPTIONS
		respond @trail_options 204
		@trail_archive method GET HEAD
		file_server @trail_archive
		respond 404
	}

	reverse_proxy 127.0.0.1:8787 {
		transport http {
			dial_timeout 5s
			response_header_timeout 30s
		}
	}

	log {
		output file /var/log/caddy/fogofwalk.log
		format json
	}
}
