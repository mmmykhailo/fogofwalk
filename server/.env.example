# Copy to server/.env and fill in. Bun loads .env automatically — no dotenv.

# Port Bun.serve listens on.
PORT=8787

# Interface to bind. 0.0.0.0 (the default) is right for a container; behind a
# reverse proxy use 127.0.0.1 so the port is not reachable from the network.
HOST=0.0.0.0

# Where the SQLite file and the geometry blobs live (sqlite-fs driver).
DATA_DIR=./data

# sqlite-fs (default) | memory (tests only)
STORE_DRIVER=sqlite-fs

# Comma-separated exact client origins. Used for CORS *and* as the
# open-redirect allowlist for ?redirect= on the OAuth start route. No "*".
ALLOWED_ORIGINS=http://localhost:5173

# Deployment-owned admin identities. Required; an admin is promoted to allowed
# at sign-in, but this value is never stored in the database.
ADMIN_LOGINS=github:your-github-login

# Signs the short-lived OAuth state cookie. 32+ characters.
# Generate one: bun -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
SESSION_SECRET=change-me-to-at-least-32-characters-long

# This server's own externally reachable base URL. The GitHub OAuth callback
# is built from it: PUBLIC_URL/api/auth/github/callback
PUBLIC_URL=http://localhost:8787

# Omit both to leave GitHub sign-in switched off.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
