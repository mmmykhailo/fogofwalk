# Copy to .env for local development. Vite loads it automatically.
#
# This file controls ONE thing: whether the client knows about a sync server.
#
#   unset  → server-less build. No sign-in row in the drawer, no network calls,
#            no account state. This is what the GitHub Pages workflow deploys.
#   set    → the drawer grows an account row and track sync is available.
#
# Must match the port in server/.env (PORT), and the client's own origin must
# appear in that file's ALLOWED_ORIGINS or sign-in will be refused.
VITE_API_URL=http://localhost:8787
